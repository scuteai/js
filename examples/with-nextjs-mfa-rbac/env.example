# Copy this file to .env.local and fill in your app's values.
# Dashboard: your app > Settings (app ID) and API keys (secret).

# Your Scute app's ID, like app_xxxxxxxxxxxxxxxxxxxx. Public: the browser uses it.
NEXT_PUBLIC_SCUTE_APP_ID=
# The Scute API. Leave it as is unless Scute gave you another URL.
NEXT_PUBLIC_SCUTE_BASE_URL=https://api.scute.io
# Your app's secret API key. Server only: never prefix it with NEXT_PUBLIC_.
SCUTE_SECRET=
