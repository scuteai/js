# LiveKit project (LiveKit Cloud free tier or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxx

# Your running Scute API + the app the agent belongs to
SCUTE_API_URL=http://localhost:3333
SCUTE_APP_ID=app_xxxxxxxx

# The agent this worker serves + its M2M token (from launch). The worker fetches
# its config from Scute (M03) and routes tools through the hosted guard.
SCUTE_AGENT_ID=
SCUTE_AGENT_TOKEN=

# Model/inference keys. The agent uses LiveKit Inference (inference.STT/LLM/TTS);
# set the keys your LiveKit project's inference is configured for, or swap to
# direct plugins (@livekit/agents-plugin-openai, -deepgram, -cartesia).
OPENAI_API_KEY=sk-...

# M09 optional: use ElevenLabs as the TTS voice inside this LiveKit worker. Add
# @livekit/agents-plugin-elevenlabs and replace the inference.TTS line in agent.ts
# with `new elevenlabs.TTS({ voiceId: "..." })`. (The standalone ElevenLabs path
# is the ElevenLabs provider adapter; this is the LiveKit-transport variant.)
ELEVEN_API_KEY=

TOKEN_SERVER_PORT=3100
