{
  "name": "scute-js",
  "private": true,
  "scripts": {
    "build": "pnpm turbo\\ run build",
    "dev": "pnpm turbo\\ run dev",
    "docs": "typedoc",
    "lint": "pnpm turbo\\ run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "turbo run": "turbo run --concurrency 30",
    "verdaccio-start": "pnpm verdaccio --config ./verdaccio.config.yaml"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.1",
    "@scute/eslint-config": "workspace:*",
    "@turbo/gen": "^1.10.3",
    "eslint": "^8.42.0",
    "prettier": "^2.8.8",
    "syncpack": "^10.5.1",
    "turbo": "^1.10.3",
    "typescript": "4.9.5",
    "typedoc": "^0.24.8",
    "verdaccio": "^5.25.0"
  },
  "packageManager": "pnpm@8.4.0",
  "pnpm": {
    "overrides": {
      "body-parser@<1.20.3": "1.20.3",
      "cross-spawn@<6.0.6": "6.0.6",
      "cross-spawn@>=7.0.0 <7.0.5": "7.0.5",
      "semver@<5.7.2": "5.7.2",
      "semver@>=6.0.0 <6.3.1": "6.3.1",
      "semver@>=7.0.0 <7.5.2": "7.5.2",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "glob@>=10.0.0 <10.5.0": "10.5.0",
      "validator@<13.15.22": "13.15.22",
      "picomatch@<2.3.2": "2.3.2",
      "handlebars": "4.7.9",
      "jws": "3.2.3",
      "flatted": "3.4.2",
      "rollup": "4.59.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "form-data@<2.5.6": "2.5.6",
      "tmp@<0.2.7": "0.2.7",
      "path-to-regexp@<0.1.13": "0.1.13",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "js-yaml@>=3.0.0 <3.15.0": "3.15.0",
      "brace-expansion@<1.1.16": "1.1.16",
      "lodash": "4.18.0",
      "lodash-es": "4.18.0"
    }
  }
}
