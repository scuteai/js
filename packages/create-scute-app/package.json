{
  "name": "create-scute-app",
  "version": "0.2.0",
  "description": "Set up Scute auth in your project",
  "bin": {
    "create-scute-app": "src/index.mjs"
  },
  "type": "module",
  "exports": {
    "./recipes": {
      "types": "./src/recipes.d.ts",
      "default": "./src/recipes.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "scute",
    "auth",
    "passkeys",
    "webauthn",
    "magic-link"
  ]
}
